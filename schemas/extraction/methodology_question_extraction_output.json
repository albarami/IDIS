{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idis.local/schemas/extraction/methodology_question_extraction_output.json",
  "title": "MethodologyQuestionExtractionOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "searched_document_ids",
    "searched_span_ids",
    "searched_scope_sha256",
    "factual_outputs",
    "gap_finding"
  ],
  "properties": {
    "outcome": {"enum": ["EVIDENCE_FOUND", "EVIDENCE_NOT_FOUND"]},
    "searched_document_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "searched_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
    "searched_scope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "factual_outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/factual_output"}
    },
    "gap_finding": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "finding"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "finding": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "EVIDENCE_FOUND"}}},
      "then": {
        "properties": {
          "factual_outputs": {"minItems": 1},
          "gap_finding": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "EVIDENCE_NOT_FOUND"}}},
      "then": {
        "properties": {
          "factual_outputs": {"maxItems": 0},
          "gap_finding": {"type": "object"}
        }
      }
    }
  ],
  "$defs": {
    "period": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"const": "none"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "date"],
          "properties": {
            "kind": {"const": "as_of"},
            "date": {"type": "string", "format": "date"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "start_date", "end_date"],
          "properties": {
            "kind": {"const": "range"},
            "start_date": {"type": "string", "format": "date"},
            "end_date": {"type": "string", "format": "date"}
          }
        }
      ]
    },
    "scalar_value": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "amount", "currency"], "properties": {"type": {"const": "monetary"}, "amount": {"type": ["string", "number"]}, "currency": {"type": "string", "minLength": 3, "maxLength": 3}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "percentage"}, "value": {"type": ["string", "number"]}, "allow_overflow": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "count"}, "value": {"type": "integer", "minimum": 0}, "unit": {"type": ["string", "null"]}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "date"}, "value": {"type": "string", "format": "date"}, "label": {"type": ["string", "null"]}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "unit"], "properties": {"type": {"const": "range"}, "min_value": {"type": ["string", "number", "null"]}, "max_value": {"type": ["string", "number", "null"]}, "unit": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "text"}, "value": {"type": "string", "minLength": 1}, "tags": {"type": "array", "items": {"type": "string"}}}}
      ]
    },
    "typed_value": {
      "oneOf": [
        {"$ref": "#/$defs/scalar_value"},
        {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "boolean"}, "value": {"type": "boolean"}}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "contract_version", "columns"],
          "properties": {
            "type": {"const": "table_row"},
            "contract_version": {"const": "methodology-table-contract-v1"},
            "columns": {
              "type": "object",
              "additionalProperties": false,
              "required": ["row_label", "metric", "value", "unit", "period"],
              "properties": {
                "row_label": {"type": "string", "minLength": 1},
                "metric": {"type": "string", "minLength": 1},
                "value": {
                  "oneOf": [
                    {"$ref": "#/$defs/scalar_value"},
                    {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"const": "boolean"}, "value": {"type": "boolean"}}}
                  ]
                },
                "unit": {"type": "string", "minLength": 1},
                "period": {"$ref": "#/$defs/period"}
              }
            }
          }
        }
      ]
    },
    "factual_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "predicate",
        "claim_class",
        "value",
        "period",
        "unit",
        "claim_text",
        "accepted_source_span_ids",
        "accepted_locator_sha256s"
      ],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "claim_class": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/typed_value"},
        "period": {"$ref": "#/$defs/period"},
        "unit": {"type": "string", "minLength": 1},
        "claim_text": {"type": "string", "minLength": 1},
        "accepted_source_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
        "accepted_locator_sha256s": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    }
  }
}
